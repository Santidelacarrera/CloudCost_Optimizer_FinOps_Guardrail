# Copia a .env (NUNCA lo subas a Git). Los secretos reales van en un gestor (aws-sm:...), no aquí.
ENV=development
POSTGRES_PASSWORD=change-me-admin
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://cloudcost_app:change-me-app@postgres:5432/cloudcost
REDIS_URL=redis://redis:6379/0
AUTH_MODE=dev
JWT_SECRET=dev-only-secret-change-me-0123456789-abcdef
DEMO_ENABLED=true
CORS_ORIGINS=http://localhost:5985
PUBLIC_WEB_URL=http://localhost:5985
# Cuentas propias (registro, contraseña, 2FA). En desarrollo, sin SMTP_HOST los enlaces de confirmación se muestran en pantalla.
AUTH_LOCAL_ENABLED=true
# false: solo se crean cuentas con invitación (cuando ya existen las cuentas fundadoras)
AUTH_SIGNUP_OPEN=true
# Secreto del servidor para hashes de contraseña y cifrado del 2FA. En producción: 32+ caracteres propios, y NO lo cambies después
# (invalidaría contraseñas y 2FA). Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_PEPPER=dev-only-pepper-change-me-0123456789abcdef
AUTH_HIBP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CloudCost <no-reply@localhost>
# GitHub real (opcional; sin esto se usa el proveedor local de demo)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# OPA_MODE=audit                                 # por defecto: audit en desarrollo, enforce en producción
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
# LLM asesor (opcional, apagado por defecto; no recibe credenciales ni ejecuta acciones)
LLM_ENABLED=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Producción: AUTH_MODE=local (cuentas propias) u oidc, DEMO_ENABLED=false, OIDC_ISSUER/OIDC_AUDIENCE/OIDC_JWKS_URL
# SSO con OpenID Connect (Microsoft Entra ID u Okta). Guía paso a paso en docs/sso.md
SSO_ENABLED=false
# SSO_PROVIDER=entra                      # entra | okta | generic
# SSO_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0     # Okta: https://<org>.okta.com/oauth2/default
# SSO_TENANT_ID=<GUID del directorio>     # solo Entra
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_ORG_ID=<UUID de la organización de CloudCost a la que entra este IdP>
# SSO_ALLOWED_DOMAINS=acme.com
# SSO_ROLE_MAP=<grupo-o-rol>:ADMIN,<otro>:FINOPS
# SSO_DEFAULT_ROLE=VIEWER                 # vacío = rechazar a quien no tenga grupo/rol mapeado
# Puertos del host (cámbialos si están ocupados o reservados, p. ej. en Windows)
API_PORT=5986
WEB_PORT=5985
# Llaves de acceso (WebAuthn): activas por defecto; el RP ID sale de PUBLIC_WEB_URL. Ver docs/passkeys.md
PASSKEYS_ENABLED=true

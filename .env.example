# Copia a .env (NUNCA lo subas a Git). Los secretos reales van en un gestor (aws-sm:...), no aquí.
ENV=development
POSTGRES_PASSWORD=change-me-admin
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://cloudcost_app:change-me-app@postgres:5432/cloudcost
REDIS_URL=redis://redis:6379/0
AUTH_MODE=dev
JWT_SECRET=dev-only-secret-change-me-0123456789-abcdef
DEMO_ENABLED=true
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# GitHub real (opcional; sin esto se usa el proveedor local de demo)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# LLM asesor (opcional, apagado por defecto; no recibe credenciales ni ejecuta acciones)
LLM_ENABLED=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Producción: AUTH_MODE=oidc, DEMO_ENABLED=false, OIDC_ISSUER/OIDC_AUDIENCE/OIDC_JWKS_URL

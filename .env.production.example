# Copia a .env.production en el SERVIDOR (nunca lo subas a Git) y rellena TODO lo que dice CAMBIAR.
# Uso:  docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# Docker Compose se niega a arrancar si falta alguna variable obligatoria.

# --- dominio y TLS
SITE_DOMAIN=CAMBIAR.tu-dominio.cl                 # el DNS (registro A/AAAA) debe apuntar a este servidor
PUBLIC_WEB_URL=https://CAMBIAR.tu-dominio.cl      # misma dirección, con https://
ACME_EMAIL=CAMBIAR@tu-dominio.cl                  # avisos de vencimiento del certificado

# --- imágenes (las publica .github/workflows/release.yml)
IMAGE_PREFIX=ghcr.io/santidelacarrera/cloudcost
IMAGE_TAG=latest                                  # mejor una versión fija, p. ej. 1.0.0 (permite volver atrás)

# --- secretos (genera cada uno distinto:  openssl rand -base64 48)
AUTH_PEPPER=CAMBIAR                               # 32+ caracteres. No lo sobrescribas: para cambiarlo sigue docs/pepper-rotation.md (no invalida nada)
AUTH_PEPPER_ID=1                                  # sube a 2, 3… SOLO al rotar el pepper
AUTH_PEPPER_PREVIOUS=                             # al rotar: 1:<pepper anterior>   (varios: 1:...,2:...)
POSTGRES_PASSWORD=CAMBIAR                         # dueño del esquema; solo lo usan las migraciones y las copias
APP_DB_PASSWORD=CAMBIAR                           # rol cloudcost_app (sin superusuario, sin BYPASSRLS)

# --- correo (obligatorio: verificación de cuenta y recuperación de contraseña)
SMTP_HOST=CAMBIAR                                 # p. ej. email-smtp.us-east-1.amazonaws.com, smtp.postmarkapp.com, smtp.resend.com
SMTP_PORT=587
SMTP_USER=CAMBIAR
SMTP_PASSWORD=CAMBIAR
SMTP_FROM=CloudCost <no-reply@CAMBIAR.tu-dominio.cl>      # el dominio debe tener SPF, DKIM y DMARC (docs/email.md)

# --- registro: true = cualquiera puede crear una organización nueva. Ciérralo (false) cuando ya hayas creado las cuentas fundadoras;
#     después solo se entra por invitación de un administrador (Equipo → Invitar). Para sumar otra organización, reábrelo un momento.
AUTH_SIGNUP_OPEN=true

# --- seguridad opcional
AUTH_HIBP_ENABLED=true                            # rechaza contraseñas filtradas (consulta anónima por k-anonimato; si falla, no bloquea)

# --- copias de seguridad
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
BACKUP_S3_URI=                                    # opcional: s3://mi-bucket/cloudcost (necesita AWS_* o un rol de instancia)
BACKUP_PING_URL=                                  # opcional: URL de healthchecks.io / Uptime Kuma que avisa si dejan de llegar copias
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- integraciones (opcionales)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITLAB_API_URL=https://gitlab.com/api/v4          # GitLab autoalojado: https://gitlab.miempresa.com/api/v4
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
LLM_ENABLED=false
OPENAI_API_KEY=
GRAFANA_PASSWORD=CAMBIAR

# --- SSO con OIDC (opcional; guía en docs/sso.md). Registra <PUBLIC_WEB_URL>/api/auth/sso/callback en tu IdP.
# SSO_ENABLED=true
# SSO_PROVIDER=entra                    # entra | okta | generic
# SSO_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0       # Okta: https://<org>.okta.com/oauth2/default
# SSO_TENANT_ID=<TENANT_ID>             # solo Entra
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_ORG_ID=<UUID de la organización de CloudCost>
# SSO_ROLE_MAP=<grupo-o-rol>:ADMIN,<otro>:FINOPS
# SSO_DEFAULT_ROLE=VIEWER               # vacío = rechazar a quien no tenga grupo/rol
# AUTH_LOCAL_ENABLED=false              # opcional: dejar el SSO como única vía de acceso
# --- Llaves de acceso (WebAuthn / passkeys, activas por defecto). El RP ID es el dominio de PUBLIC_WEB_URL: NO lo cambies una vez que haya
#     llaves registradas (quedarían inservibles). Guía en docs/passkeys.md
# PASSKEYS_ENABLED=true
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGINS=
